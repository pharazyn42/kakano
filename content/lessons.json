        { "type": "sentence", "id": "s-kei-te-pehea", "mi": "Kei te pēhea koe?", "en": "How are you?", "distractors": ["au", "pai"], "note": "Pattern: Kei te + state + person." },
        { "type": "sentence", "id": "s-kei-te-pai-au", "mi": "Kei te pai au.", "en": "I am good.", "distractors": ["koe", "ia"] },
